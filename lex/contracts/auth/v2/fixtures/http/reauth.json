{
  "contract": 2,
  "cases": [
    {
      "id": "v2-401-not-authenticated",
      "server": "v2",
      "server_case": "session_missing",
      "description": "No session (or an ended one) on a background request.",
      "request": {
        "method": "GET",
        "path": "api/model_entries/fund/list"
      },
      "response": {
        "status": 401,
        "type": "basic",
        "headers": {
          "content-type": "application/json",
          "www-authenticate": "Session realm=\"LEX-demo\"",
          "cache-control": "no-store"
        },
        "body": {
          "error": "not_authenticated",
          "login_url": "/oidc/authenticate"
        }
      },
      "expect": {
        "kind": "reauth",
        "reason": "not_authenticated",
        "loginUrl": "/oidc/authenticate",
        "retry": {
          "GET": false,
          "POST": false
        }
      }
    },
    {
      "id": "v2-401-session-expired",
      "server": "v2",
      "server_case": "session_expired",
      "description": "Keycloak answered invalid_grant on refresh: the session ended.",
      "request": {
        "method": "POST",
        "path": "api/model_entries/fund/1/one"
      },
      "response": {
        "status": 401,
        "type": "basic",
        "headers": {
          "content-type": "application/json",
          "www-authenticate": "Session realm=\"LEX-demo\"",
          "cache-control": "no-store"
        },
        "body": {
          "error": "session_expired",
          "login_url": "/oidc/authenticate"
        }
      },
      "expect": {
        "kind": "reauth",
        "reason": "session_expired",
        "loginUrl": "/oidc/authenticate",
        "retry": {
          "GET": false,
          "POST": false
        }
      }
    },
    {
      "id": "v2-401-offsite-login-url-dropped",
      "server": "v2",
