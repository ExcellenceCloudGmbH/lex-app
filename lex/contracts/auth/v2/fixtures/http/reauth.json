        "method": "GET",
        "path": "api/user/"
      },
      "response": {
        "status": 401,
        "type": "basic",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "error": "not_authenticated",
          "login_url": "https://evil.example/oidc/authenticate"
        }
      },
      "expect": {
        "kind": "reauth",
        "reason": "not_authenticated",
        "loginUrl": null,
        "retry": {
          "GET": false,
          "POST": false
        }
      }
    },
    {
      "id": "v2-401-protocol-relative-login-url-dropped",
      "server": "v2",
      "server_case": null,
      "description": "A protocol-relative login_url is not same-origin.",
