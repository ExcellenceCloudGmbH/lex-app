        },
        "body": {
          "detail": "Authentication credentials were not provided."
        }
      },
      "expect": {
        "kind": "reauth",
        "reason": "legacy_403",
        "loginUrl": null,
        "retry": {
          "GET": false,
          "POST": false
        }
      }
    },
