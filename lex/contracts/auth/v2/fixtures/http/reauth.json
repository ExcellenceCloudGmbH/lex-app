        "method": "GET",
        "path": "api/user/"
      },
      "response": {
        "status": 401,
        "type": "basic",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "error": "not_authenticated",
          "login_url": "//evil.example/oidc/authenticate"
        }
      },
      "expect": {
        "kind": "reauth",
        "reason": "not_authenticated",
        "loginUrl": null,
        "retry": {
          "GET": false,
          "POST": false
        }
      }
    },
    {
      "id": "legacy-401-codeflow-1x",
      "server": "legacy",
      "server_case": "legacy_refresh_failed",
      "description": "django-oauth2-codeflow 1.x/2.0 JSON 401 after a failed refresh.",
      "request": {
        "method": "POST",
        "path": "api/model_entries/fund/1/one"
      },
      "response": {
        "status": 401,
        "type": "basic",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "error": "{\"error\":\"invalid_grant\",\"error_description\":\"Session not active\"}",
          "token_type": "access_token"
        }
      },
      "expect": {
        "kind": "reauth",
        "reason": "legacy_401",
        "loginUrl": null,
        "retry": {
          "GET": false,
          "POST": false
        }
      }
    },
    {
      "id": "legacy-403-drf-not-authenticated",
      "server": "legacy",
      "server_case": "legacy_drf_not_authenticated",
      "description": "DRF NotAuthenticated rendered as 403 (first auth class has no authenticate_header).",
      "request": {
        "method": "GET",
        "path": "api/model_entries/fund/1/one"
      },
      "response": {
        "status": 403,
        "type": "basic",
        "headers": {
