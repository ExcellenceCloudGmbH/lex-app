[run]
branch = True
relative_files = True
# Tag every hit line with the fully-qualified dotted name of the test
# function that produced it (e.g. ``lex.test_project.tests.init.test_1a.
# TestInit.test_bar|run``). The showcase runner uses this to compute
# per-cluster coverage without a manual ``cov_include`` list — a file
# counts toward a cluster's denominator only if a test in that cluster
# actually *executed* one of its lines (not just imported it).
dynamic_context = test_function
# The lex codebase uses both fully-qualified imports (lex.core.models.LexModel)
# AND bare Django-app-level imports (core.models.LexModel, lex_app.settings,
# api.utils, audit_logging.mixins, etc.).  Python registers the module under
# whichever name imports it first, and coverage decides whether to trace a
# module based on its *module name*, not file path.  With only `source = lex`,
# modules first loaded via the bare app name are SILENTLY SKIPPED — causing
# critical files like LexModel.py, CalculatedModelMixin.py, and AuditLogMixin.py
# to show 0% coverage even though they run during every test.
#
# Adding the bare app names below tells coverage to also trace those namespaces.
# Use the filesystem path to the editable install so coverage traces ALL
# framework code regardless of whether the module was imported as lex.core.X
# or bare core.X.  The lex CLI adds lex/ to sys.path at runtime, making
# "core", "api", etc. importable as top-level packages — but coverage can't
# resolve those package names at startup.  Pointing at the directory ensures
# every .py file under lex/ is traced.
source =
    lex
omit =
    */migrations/*
    */tests/*
    lex/react/*
    frontend/*
    docs/*
    build/*
    project_example/*
    project_example_2/*
    lex/full_migration_workflow.py
    lex/fix_v1_migration.py
    lex/sanitize_v2_migrations.py
    lex/restore_legacy_logs.py
    lex/backfill_history_sql.py
    lex/extract_legacy_logs.py
    lex/lex_app/management/commands/backfill_bitemporal_history.py
    lex/lex_app/management/commands/backfill_audit_logging.py
    lex/lex_app/management/commands/Init2.py
    lex/lex_app/management/commands/detect_model_changes.py
    lex/lex_app/management/commands/full_migration_workflow.py
    lex/lex_app/management/commands/lex_migrate.py
    lex/lex_app/management/commands/normalize_is_calculated.py
    lex/lex_app/management/commands/rollback_migration_state.py
    lex/lex_app/management/commands/generate_legacy_freeze_manifest.py
    lex/lex_app/management/commands/sync_keycloak.py
    lex/lex_app/management/commands/capture_migration_state.py
    lex/lex_app/management/commands/capture_db_tables.py
    lex/lex_app/management/commands/create_db.py
    lex/bin/lex.py
    lex/legacy_data/apps.py
    lex/authentication/management/commands/keycloak_backup.py
    lex/authentication/management/commands/keycloak_rollback_bak.py
    lex/authentication/management/commands/keycloak_init_bak.py
    lex/authentication/management/commands/register_keycloak_resources.py
    lex/authentication/management/commands/delete_keycloak_resources.py
    lex/utilities/import_system/*
    lex/lex_app/asgi.py
    lex/lex_app/wsgi.py
    lex/tools/setup_with_ai.py
    lex/streamlit_app.py
    lex/lex_app/streamlit/*
    lex/proxy.py
    lex/manage.py
    lex/api/views/authentication/KeycloakManager.py
    # --- Supervisor-approved EXCLUDE list (May 2026) ------------------------
    # Non-test-worthy code: scaffolding, console handlers, legacy data models,
    # routing shims, ProjectInfo view, dev-only utilities.
    lex/test_project/apps.py
    lex/tools/test_groups.py
    lex/api/views/sharepoint/DeleteUnusedFiles.py
    lex/lex_app/routing.py
    lex/audit_logging/handlers/ConsoleHandler.py
    lex/authentication/utils/lex_authentication.py
    lex/utilities/channel_layer.py
    lex/legacy_data/admin/read_only_admin.py
    lex/api/utils/collection_utils.py
    lex/core/models/HTMLReport.py
    lex/legacy_data/models/legacy_calculation_id.py
    lex/legacy_data/models/legacy_log.py
    lex/legacy_data/models/legacy_user_change_log.py
    lex/api/views/project_info/ProjectInfo.py
    lex/legacy_data/models/legacy_calculation_log.py
    lex/legacy_data/serializers/legacy_data_serializers.py

[report]
show_missing = True
skip_covered = False
precision = 2
# Exclude test and migration files from coverage reports.
# These are also listed under [run] omit, but repeating them here
# ensures that coverage report / coverage xml / coverage html all
# honour the exclusions even when relative_files = True causes the
# [run] omit globs to resolve differently (e.g. on CI).
omit =
    */migrations/*
    */tests/*
    lex/react/*
    frontend/*
    docs/*
    build/*
    project_example/*
    project_example_2/*
    lex/fix_v1_migration.py
    lex/sanitize_v2_migrations.py
    lex/restore_legacy_logs.py
    lex/backfill_history_sql.py
    lex/extract_legacy_logs.py
    lex/full_migration_workflow.py
    lex/proxy.py
    lex/manage.py
    lex/lex_app/management/commands/backfill_bitemporal_history.py
    lex/lex_app/management/commands/backfill_audit_logging.py
    lex/lex_app/management/commands/Init2.py
    lex/lex_app/management/commands/detect_model_changes.py
    lex/lex_app/management/commands/full_migration_workflow.py
    lex/lex_app/management/commands/lex_migrate.py
    lex/lex_app/management/commands/normalize_is_calculated.py
    lex/lex_app/management/commands/rollback_migration_state.py
    lex/lex_app/management/commands/generate_legacy_freeze_manifest.py
    lex/lex_app/management/commands/sync_keycloak.py
    lex/lex_app/management/commands/capture_migration_state.py
    lex/lex_app/management/commands/capture_db_tables.py
    lex/lex_app/management/commands/create_db.py
    lex/bin/lex.py
    lex/legacy_data/apps.py
    lex/authentication/management/commands/keycloak_backup.py
    lex/authentication/management/commands/keycloak_rollback_bak.py
    lex/authentication/management/commands/keycloak_init_bak.py
    lex/authentication/management/commands/register_keycloak_resources.py
    lex/authentication/management/commands/delete_keycloak_resources.py
    lex/utilities/import_system/*
    lex/lex_app/asgi.py
    lex/lex_app/wsgi.py
    lex/tools/setup_with_ai.py
    lex/lex_app/streamlit/*
    lex/streamlit_app.py
    lex/api/views/authentication/KeycloakManager.py
    # --- Supervisor-approved EXCLUDE list (May 2026) ------------------------
    lex/test_project/apps.py
    lex/tools/test_groups.py
    lex/api/views/sharepoint/DeleteUnusedFiles.py
    lex/lex_app/routing.py
    lex/audit_logging/handlers/ConsoleHandler.py
    lex/authentication/utils/lex_authentication.py
    lex/utilities/channel_layer.py
    lex/legacy_data/admin/read_only_admin.py
    lex/api/utils/collection_utils.py
    lex/core/models/HTMLReport.py
    lex/legacy_data/models/legacy_calculation_id.py
    lex/legacy_data/models/legacy_log.py
    lex/legacy_data/models/legacy_user_change_log.py
    lex/api/views/project_info/ProjectInfo.py
    lex/legacy_data/models/legacy_calculation_log.py
    lex/legacy_data/serializers/legacy_data_serializers.py
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if TYPE_CHECKING:

[html]
directory = coverage_html